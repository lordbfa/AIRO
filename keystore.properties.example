# Copy this file to keystore.properties (already gitignored) and fill in your real values.
# Generate an upload keystore with (run once, keep the resulting .jks file and these values safe):
#   keytool -genkeypair -v -keystore airo-upload.jks -alias airo -keyalg RSA -keysize 2048 -validity 10000
# storeFile is resolved relative to the project root.
storeFile=airo-upload.jks
storePassword=changeit
keyAlias=airo
keyPassword=changeit
