# Copy this file to local.properties (already gitignored) and fill in your keys.
ANTHROPIC_API_KEY=sk-ant-...

# OAuth 2.0 Web client ID from the Firebase console (Authentication > Sign-in method > Google),
# used by Credential Manager's GetGoogleIdOption to request a Google ID token. See FIREBASE_SETUP.md.
GOOGLE_WEB_CLIENT_ID=123456789-abc.apps.googleusercontent.com
